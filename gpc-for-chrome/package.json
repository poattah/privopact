{
  "name": "privopact-gpc",
  "version": "0.1.2",
  "description": "Free, open-source Chrome extension that sends the Global Privacy Control signal to every site.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/poattah/privopact.git",
    "directory": "gpc-for-chrome"
  },
  "homepage": "https://privopact.com/gpc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "zip": "npm run build && (cd dist && zip -r ../extension.zip . -x '*.DS_Store*')"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
